# Shared settings for the deploy scripts. Edit to taste.

# AgentCore runtime name. Pattern: [a-zA-Z][a-zA-Z0-9_]{0,47} -- letters, digits
# and underscores only, no hyphens.
export AGENT_NAME="${AGENT_NAME:-ballerina_agent}"

export AWS_REGION="${AWS_REGION:-us-east-1}"
export ECR_REPO="${ECR_REPO:-bedrock-agentcore-ballerina-agent}"
export IMAGE_TAG="${IMAGE_TAG:-latest}"
export EXECUTION_ROLE_NAME="${EXECUTION_ROLE_NAME:-BedrockAgentCoreRuntime-${AGENT_NAME}}"

# Name of the Secrets Manager secret holding the Anthropic API key, used by
# 04-create-runtime.sh to read the key at deploy time.
export ANTHROPIC_SECRET_NAME="${ANTHROPIC_SECRET_NAME:-anthropic/api-key}"

# --- Networking ------------------------------------------------------------
# PUBLIC: AgentCore manages the network; the container reaches the internet
#         (needed while the agent calls the Anthropic API directly).
# VPC:    ENIs are placed in your subnets.  Run ./06-create-vpc.sh first, then
#         set the two variables below from its output.
export NETWORK_MODE="${NETWORK_MODE:-PUBLIC}"
export AGENT_SUBNETS="${AGENT_SUBNETS:-}"          # comma-separated subnet-...
export AGENT_SECURITY_GROUPS="${AGENT_SECURITY_GROUPS:-}"  # comma-separated sg-...
