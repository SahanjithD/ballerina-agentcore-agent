# Shared settings for the deploy scripts. Edit to taste.

# AgentCore runtime name. Pattern: [a-zA-Z][a-zA-Z0-9_]{0,47} -- letters, digits
# and underscores only, no hyphens.
export AGENT_NAME="${AGENT_NAME:-ballerina_agent}"

export AWS_REGION="${AWS_REGION:-us-east-1}"
export ECR_REPO="${ECR_REPO:-bedrock-agentcore-ballerina-agent}"
export IMAGE_TAG="${IMAGE_TAG:-latest}"
export EXECUTION_ROLE_NAME="${EXECUTION_ROLE_NAME:-BedrockAgentCoreRuntime-${AGENT_NAME}}"

# Secrets Manager secret holding the Anthropic API key, read by
# 03-deploy-runtime.sh at deploy time.
export ANTHROPIC_SECRET_NAME="${ANTHROPIC_SECRET_NAME:-anthropic/api-key}"

# --- Gateway tool backends (tools/mcp-server and tools/rest-api) -------------

# Ballerina MCP server, hosted on its own AgentCore Runtime with serverProtocol MCP.
# Same naming rule as AGENT_NAME: [a-zA-Z][a-zA-Z0-9_]{0,47}, no hyphens.
export MCP_AGENT_NAME="${MCP_AGENT_NAME:-ballerina_tools_mcp}"
export MCP_ECR_REPO="${MCP_ECR_REPO:-bedrock-agentcore-ballerina-tools-mcp}"
export MCP_EXECUTION_ROLE_NAME="${MCP_EXECUTION_ROLE_NAME:-BedrockAgentCoreRuntime-${MCP_AGENT_NAME}}"

# Ballerina REST API, hosted as a Lambda container image behind a Function URL.
# AgentCore Runtime cannot host this: its HTTP contract mounts only /invocations.
export REST_FUNCTION_NAME="${REST_FUNCTION_NAME:-ballerina-tools-rest-api}"
export REST_ECR_REPO="${REST_ECR_REPO:-ballerina-tools-rest-api}"
export REST_ROLE_NAME="${REST_ROLE_NAME:-LambdaExecution-${REST_FUNCTION_NAME}}"

# The gateway that both targets are attached to, e.g. ballerina-agent-gatewa-01gzl3luj1.
export GATEWAY_ID="${GATEWAY_ID:-ballerina-agent-gatewa-01gzl3luj1}"

# Set this to skip the aws sts get-caller-identity call the scripts use to discover
# the account id -- handy when the STS endpoint is unreachable but ECR is not.
# Left blank deliberately: the account id does not belong in a committed file.
export ACCOUNT_ID="${ACCOUNT_ID:-}"
